@startuml

abstract class Conta {
    - String numero
    - Cliente cliente
    # Number saldo
    - Transacao[] historico
    + depositar(valor : Number) : void
    + sacar(valor : Number) : boolean
    + transferir(valor : Number, contaDestino : Conta) : void
    + {abstract} exibirExtrato() : void
    + toJSON() : Object
}

class Cliente {
    - String nome
    - String cpf
    - String email
    - Endereco endereco
    + get nome() : String
    + set nome(novoNome : String) : void
    + get email() : String
    + set email(novoEmail : String) : void
    + toJSON() : Object
    + {static} fromJSON(json : String) : Cliente
}

class Endereco {
    - String logradouro
    - String numero
    - String bairro
    - String cidade
    - String cep
    - String complemento
    + toJSON() : Object
}

class Transacao {
    - Date data
    - Number valor
    - String tipo
    - String descricao
    + {static} criarTransferencia(valor : Number) : Transacao[]
    + toJSON() : Object
}

class ContaCorrente {
    - Number limite
    + sacar(valor : Number) : boolean
    + exibirExtrato() : void
}

class ContaPoupanca {
    - Number taxaRendimento
    + renderJuros() : void
    + exibirExtrato() : void
}

Conta <|-- ContaCorrente
Conta <|-- ContaPoupanca

Cliente "1" *-- "0..1" Endereco : Composição
Cliente "1" -- "0..*" Conta : Associação
Conta "1" *-- "0..*" Transacao : Composição

@enduml
